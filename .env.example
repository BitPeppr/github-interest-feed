# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# GitHub token (server-side only, raises API rate limits). Never expose client-side.
GITHUB_TOKEN=

# Embedding provider (server-side only). Semantic retrieval stays off until
# this is set and the backfill runs (`embeddings:backfill`).
OPENAI_API_KEY=
# Optional: override the embedding model (must match EMBEDDING_DIMENSIONS)
# or point at an OpenAI-compatible endpoint.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
